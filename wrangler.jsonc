{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gist-mcp-oauth",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    { "pattern": "auth.likui.space", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "8754177290e74e809c8204f268efe46e" }
  ],
  "vars": {
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liNyq8zrZF6HivMp"
  }
}
